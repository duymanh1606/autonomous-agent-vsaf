# Copy thành .env hoặc export bằng secret manager; không commit key thật.
GEMINI_API_KEY=your_gemini_api_key

# Ký session cookie đăng nhập dashboard (dashboard_api/auth.py). Nếu bỏ trống,
# một key ngẫu nhiên được sinh mỗi lần khởi động - mọi người sẽ bị đăng xuất
# sau mỗi lần restart dashboard_api. Sinh một key thật bằng:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SECRET_KEY=

# Shared PostgreSQL database for every account. Isolation is logical,
# by `account_id`; the URL carries a password so it lives here, not in YAML.
AGENT_DATABASE_URL=postgresql://agent:agent@127.0.0.1:25432/agent

# Test server (tests create a throwaway schema per test).
AGENT_TEST_DATABASE_URL=postgresql://agent:agent@127.0.0.1:25432/agent

# Optional overrides read by compose.yaml. These defaults match the URLs above.
# If you change POSTGRES_PORT, also update AGENT_DATABASE_URL/
# AGENT_TEST_DATABASE_URL above to the same port - they are separate env
# vars on purpose (the supervisor connects to Postgres directly, not through
# the dashboard container), so nothing keeps them in sync automatically.
POSTGRES_DB=agent
POSTGRES_USER=agent
# Đổi trước khi deploy lên server. Postgres chỉ bind 127.0.0.1 nên mật khẩu
# mặc định không lộ ra mạng - nhưng ai SSH được vào server cũng đọc được
# toàn bộ dữ liệu khách hàng nếu để nguyên "agent". Sinh bằng:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# và nhớ sửa cùng mật khẩu đó trong 2 dòng AGENT_*DATABASE_URL ở trên.
POSTGRES_PASSWORD=agent
POSTGRES_PORT=25432

# Nơi deploy/backup.sh đẩy bản sao lưu ra NGOÀI máy (rclone remote hoặc đích
# rsync). Để trống thì bản sao lưu chỉ nằm trên cùng ổ đĩa với dữ liệu gốc -
# cứu được khi lỡ tay xoá, không cứu được khi hỏng ổ / mất máy.
#   BACKUP_REMOTE=gdrive:agent-backups
#   BACKUP_REMOTE=user@backup-host:/srv/agent-backups
BACKUP_REMOTE=
# age PUBLIC key the archive is encrypted to (deploy/README.md section 7).
# Generate the pair on YOUR machine (`age-keygen -o backup-key.txt`) and keep
# the private half off this server. Without it, deploy/backup.sh refuses to
# copy anything to BACKUP_REMOTE: the archive holds every customer message and
# every API key, and .env itself is only included when this is set.
# BACKUP_AGE_RECIPIENT=age1...
# rclone only: delete remote archives older than this many days (0 = never).
# BACKUP_REMOTE_KEEP_DAYS=30

# All the ports below default away from common well-known ports (5432, 8080,
# 5173, 9222, 8765, 8900, 5900, 6080) precisely so a fresh deploy is unlikely
# to collide with something else already running on the server - see "Đổi
# port" in deploy/README.md. Every account's actual port is derived from the
# three AGENT_*_BASE_PORT values (base + account index) and is only re-read
# the next time each account's config is (re)written, so change these BEFORE
# creating new workspaces on a given server. Uncomment only to move them
# again if even these still collide with something on your server.

# Supervisor (dashboard_api) own bind port - and the exact port the
# dashboard container's nginx proxies /api to (compose.yaml), so both sides
# always move together from this one line.
# SUPERVISOR_HOST=127.0.0.1
# SUPERVISOR_PORT=28080

# Dashboard's own built frontend (nginx inside the "dashboard" container).
# DASHBOARD_PORT=25173

# Where a generated password-reset link should point (dashboard_api/main.py's
# _deliver_reset_link). Defaults to the local Vite dev server, which is wrong
# for any deployed dashboard - set this to the real address operators open
# (e.g. https://app.example.com). It is also folded into the trusted-origin
# allowlist below, so the address people actually open cannot drift out of it.
# DASHBOARD_PUBLIC_URL=http://localhost:5173

# Outgoing mail for "Quên mật khẩu" (a temporary password sent to the user's
# address) and the admin's "Gửi mật khẩu tạm qua email" - dashboard_api/mailer.py.
# Unset on a dev machine: the mail is written to data/dashboard-outbox.log
# (owner-only) instead. Unset in production: those two features refuse, and
# the log says why.
#
# Gmail: turn on 2-Step Verification for the sending account, create an App
# Password (Google Account > Security > App passwords) and put THAT here -
# never the account's normal password. Free, about 500 mails a day.
# Google shows it in four groups: keep the single quotes (or drop the spaces).
# deploy.sh sources this file as bash, where an unquoted space ends the value
# and runs the next word as a command - the service then never starts.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=ten.shop@gmail.com
# SMTP_PASSWORD='xxxx xxxx xxxx xxxx'
# SMTP_FROM=ten.shop@gmail.com

# Alerts that reach someone not looking at the dashboard (dashboard_api/alerts.py).
# Both OFF when unset. Every red dashboard alert still open after 5 minutes is
# mailed to ALERT_EMAILS (needs the SMTP_* block above), once when it starts
# and once when it clears. ALERT_HEARTBEAT_URL is pinged after every health
# sweep (5 min) - point it at a Healthchecks.io / UptimeRobot heartbeat check,
# which alerts YOU when the pings stop: server down, supervisor down, database
# unreachable. Restart the supervisor after changing these.
# ALERT_EMAILS=chu.shop@gmail.com,ky.thuat@gmail.com
# ALERT_HEARTBEAT_URL=https://hc-ping.com/your-check-uuid

# A conversation the agent hands to a person ("Chờ tiếp quản") is mailed, about
# a minute later, to the registered email of every dashboard user granted that
# workspace (its creator and the staff given access) - never to other shops'
# staff, and without the customer's message text. ON by default once SMTP_*
# works; set to off to stop it for every workspace.
# ESCALATION_EMAILS=off

# Push notifications to browsers that switched them on (dashboard: avatar ->
# Bật thông báo), delivered with the dashboard closed: a conversation handed to
# a person, a lost TikTok login, a CAPTCHA, a workspace that cannot wake. Same
# recipients as above, never the customer's words. Needs the dashboard on HTTPS
# (or localhost) and outbound HTTPS from this server to the browsers' push
# services. The server's VAPID key is created in PostgreSQL on first use - no
# setting needed. ON by default; set to off to stop every push.
# WEB_PUSH=off

# ---------------------------------------------------------------------------
# Public deployment (Cloudflare Tunnel + Access). Everything below is OFF when
# unset, which is what keeps ./dev.sh and the test suite working untouched.
# Full procedure: docs/cloudflare-tunnel.md
# ---------------------------------------------------------------------------

# Turns on the hardening that only makes sense on an internet-facing origin:
# Secure session cookies without asking a header, no /docs or /openapi.json,
# an empty CORS allowlist, and a hard refusal to start without
# DASHBOARD_SECRET_KEY. Setting CF_ACCESS_TEAM_DOMAIN implies this too, so
# forgetting the flag cannot silently downgrade the origin.
# DASHBOARD_ENV=production

# How long a session cookie lives, in seconds. Default 7 days. A password
# reset, an admin setting a password, and a deactivation all revoke existing
# sessions immediately regardless of this (users.sessions_valid_from).
# DASHBOARD_SESSION_TTL_SECONDS=604800

# Origins allowed to make state-changing requests (POST/PUT/PATCH/DELETE) and
# to open the /api/events WebSocket. Comma separated. Empty = the check is off
# entirely, which is the right setting for a loopback-only box. Include BOTH
# the public hostname and the address of the local listener you reach over
# `ssh -L`, or every POST an operator makes through the tunnel-less path 403s.
# DASHBOARD_TRUSTED_ORIGINS=https://app.example.com,http://127.0.0.1:25174

# Peers whose CF-Connecting-IP may be believed. In the supported topology
# every request arrives from loopback (cloudflared -> nginx -> supervisor).
# X-Forwarded-For is never read, on any path.
# DASHBOARD_TRUSTED_PROXIES=127.0.0.1,::1

# Browser origins allowed to read credentialed responses. Defaults to the Vite
# dev pair in development and to nothing in production, where the SPA is
# same-origin behind nginx and no legitimate caller needs CORS.
# DASHBOARD_CORS_ORIGINS=

# Verify Cloudflare Access at the origin as well as at the edge. Without it, a
# tunnel that is misconfigured to skip its Access application delivers
# anonymous internet traffic to the dashboard and the origin cannot tell.
# The team domain is the one in your Cloudflare Zero Trust URL; the AUD tag is
# on the Access application's overview page. Setting the team domain without
# the AUD tag is a startup error, because any token from that team - including
# one minted for a different application - would otherwise be accepted.
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=
# CF_ACCESS_JWKS_TTL_SECONDS=3600

# --- The whole Cloudflare block in one piece -------------------------------
# Each variable is explained above; this is the same set collected together so
# turning the tunnel on is one paste and three substitutions rather than a
# hunt through this file. Uncomment, replace the three <...> values, restart.
#
# Order matters and is not obvious: bring the tunnel up and VERIFY it in a
# private window BEFORE setting DASHBOARD_LISTEN_ADDR to loopback further
# down. Locking the door first leaves `ssh -L` as the only way in.
# Full procedure, including the Access application: docs/cloudflare-tunnel.md
#
# DASHBOARD_ENV=production
# DASHBOARD_PUBLIC_URL=https://<hostname>
# DASHBOARD_TRUSTED_ORIGINS=https://<hostname>,http://127.0.0.1:25174
# CF_ACCESS_TEAM_DOMAIN=<yourteam>.cloudflareaccess.com
# CF_ACCESS_AUD=<AUD tag from the Access application overview>
#
# The supervisor refuses to start on a half-configured version of this -
# production without DASHBOARD_SECRET_KEY, or a team domain without an AUD
# tag. An origin that only looks protected is worse than one that will not
# boot, so that refusal is deliberate.

# Interface the dashboard's nginx binds. The container uses host networking,
# so there is no port mapping to restrict and this is the only thing keeping
# the dashboard off every interface on the machine. Loopback by default;
# cloudflared reaches it from this host. Use 0.0.0.0 only for a LAN-only
# deployment with no tunnel in front of it.
# DASHBOARD_LISTEN_ADDR=127.0.0.1

# Second nginx listener, always loopback, for `ssh -L 25174:127.0.0.1:25174`.
# This is the operator's way in when Cloudflare is down or misconfigured, and
# the reason requiring an Access assertion on the tunnel listener cannot lock
# anyone out.
# DASHBOARD_LOCAL_PORT=25174

# Google Apps Script Web App URL that mirrors customer stage/order changes
# to a Google Sheet (integrations/sheet_export.py). Unset disables the
# export entirely - it is best-effort and never blocks a reply or an order
# save if this is missing or the webhook fails.
#
# Setup (see integrations/apps_script/): both .gs files must live in ONE
# Apps Script project bound to the target spreadsheet. Deploy > New
# deployment > Web app (Execute as: Me, Access: Anyone) and paste the /exec
# URL here. After any edit to the .gs code you must publish a *new version*
# of that deployment (Manage deployments > edit > Version: New version) -
# the /exec URL keeps serving the old version otherwise.
# GSHEET_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
# Must equal the WEBHOOK_TOKEN script property of that Apps Script project
# (Project Settings > Script Properties) - webhook_receiver.gs reads it from
# there, never from source.
# GSHEET_WEBHOOK_TOKEN=
# Per-request timeout (seconds) for that webhook call. Defaults to 20 - one
# call takes ~1.5-3s and concurrent calls queue behind the script lock.
# GSHEET_TIMEOUT_SECONDS=20
# The same spreadsheet's normal link. Shown as the "Xuất Google Sheet" button
# on the dashboard's Orders page, for every signed-in user of every workspace.
# Must be a https://docs.google.com/spreadsheets/d/... link; anything else
# hides the button. Read by the supervisor: restart it after changing this.
# GSHEET_URL=https://docs.google.com/spreadsheets/d/XXXX/edit

# Base CDP/control ports; account index `i` shifts each by `i` (see
# dashboard_api/accounts.py). Both are host-loopback only.
# AGENT_CDP_BASE_PORT=29222
# AGENT_CONTROL_BASE_PORT=28900

# Base X11 display number / VNC / noVNC ports for each workspace's own
# dedicated display stack (dashboard_api/processes.py) - account index `i`
# shifts each by `i`, same scheme as the ports above. Defaults are chosen
# clear of the OLD shared instance's fixed values (:99 / 25900 / 26080) so a
# server mid-migration off that setup can never collide with these even if
# the old systemd units haven't been torn down yet - see deploy/README.md.
# AGENT_DISPLAY_BASE=100
# AGENT_VNC_BASE_PORT=25901
# AGENT_NOVNC_BASE_PORT=26081
# Resolution of each workspace's own Xvfb screen. Bigger than the Chrome
# window on purpose (costs nothing - Xvfb never paints beyond what's asked
# for) rather than a display-per-workspace sizing concern.
# AGENT_XVFB_RESOLUTION=1920x1080x24

# egress-ip-gateway (egw): one public IP per TikTok workspace. ALL OPTIONAL -
# leave every line commented on a machine without egw and nothing changes.
#
# EGW_ENABLED is the master switch (default off). Off = the feature does not
# exist: no proxy on any Chrome, no CDP handler, hidden in the dashboard -
# even for workspaces that already hold a token. Tokens/routes are kept, so
# turning it back on needs no re-provisioning. Flip it, then
# `systemctl restart autonomous-agent` and Stop/Start each workspace.
# EGW_ENABLED=1
# With the switch on, a workspace still only uses the proxy once an operator
# gives it a token (dashboard > workspace > IP riêng). Setup and the API
# contract: docs/egress-proxy-integration.md and
# ~/code/egress-ip-gateway/deploy/autonomous-agent.md.
# Written into each opted-in account's YAML as `egw.proxy_url` when its
# config is generated; Chrome and the agent both read it from there.
# EGW_PROXY_URL=http://127.0.0.1:3128
# Admin API used to map a workspace to a route and to issue/revoke its token
# when the operator enables egw for an account. Same token as in the egw
# host's /etc/egw/egw.env. Read only at that moment - never at startup.
# EGW_ADMIN_URL=http://127.0.0.1:9090
# EGW_ADMIN_TOKEN=
